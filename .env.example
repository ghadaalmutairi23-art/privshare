# Copy to .env (or run: python scripts/gen_secrets.py --write). Never commit .env.

# Base64 of 32 random bytes (AES-256 key for student fields and TOTP secrets)
DATA_KEY=
# At least 32 random characters (signs the session cookie)
SECRET_KEY=

# Relative paths are resolved from the project root
DB_PATH=instance/privshare.db
SESSION_COOKIE_SECURE=true
RATELIMIT_ENABLED=true

# Differential privacy: total budget per analyst and allowed epsilon per query
EPSILON_TOTAL_DEFAULT=5.0
EPSILON_MIN=0.1
EPSILON_MAX=1.0

# GPA scale used when generating data (4 or 5); saved with the data, so change it
# and regenerate with: python -m backend.data_gen --reset
GPA_SCALE=4

# "stub" (Phase 2, in-memory) - Phase 3 adds "web3"
CHAIN_BACKEND=stub

# Simulated university information system (python -m university_sim.app)
# The same key is used by the simulator (to check) and by PrivShare (to call it).
SIS_API_KEY=
SIS_URL=https://127.0.0.1:5001
SIS_STUDENTS=520
SIS_BAD_ROWS=2

# Phase 3 (blockchain)
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=
